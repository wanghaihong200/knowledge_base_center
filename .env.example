# ====================
# MinerU API (PDF 解析)
# ====================
MINERU_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINERU_BASE_URL=https://mineru.net/api/v4

# ====================
# LLM API (智谱 BigModel OpenAI 兼容)
# ====================
# API 密钥（智谱格式 xxxx.yyyy，Embedding/Rerank 复用此 key）
OPENAI_API_KEY=xxxxxxxxxxxx.xxxxxxxxxxxx
# LLM 基础地址（coding 端点）
OPENAI_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4
# 默认 LLM 模型
LLM_DEFAULT_MODEL=glm-5.3-flash
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型（图片摘要）
VL_MODEL=glm-5.3-flash
# 商品名识别模型
ITEM_MODEL=glm-5.3-flash

# ====================
# Embedding (智谱 BigModel)
# ====================
# Embedding API 基础地址（标准 paas/v4，非 LLM 的 coding 端点）
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
# 嵌入向量维度（embedding-3 仅支持 256/512/1024/2048）
EMBEDDING_DIM=1024
# 嵌入模型名称
EMBEDDING_MODEL=embedding-3

# ====================
# Rerank (智谱 BigModel)
# ====================
RERANK_API_BASE=https://open.bigmodel.cn/api/paas/v4
TEXT_RERANK_MODEL=rerank

# ====================
# Vector Database (Milvus)
# ====================
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# Document Database (MongoDB)
# ====================
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=upload-images

# ====================
# 路径与其他
# ====================
# 导入文件本地存储根目录
DATA_BASED_ROOT_DIR=./data
# 临时文件根目录
MD_ROOT_DIR=./temp-files/
# MCP Web 搜索服务地址（智谱 web_search_prime MCP，key 复用 OPENAI_API_KEY）
MCP_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/mcp/web_search_prime/mcp
